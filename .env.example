# ---------------------------------------------------------------------------
# Careu.ro — environment variables
# Copy this file to `.env.local` (never commit real secrets).
# The web app itself needs NONE of the AI secrets: they are used only by the
# content-generation script (scripts/generate-daily-content.ts), which runs in
# GitHub Actions or locally — never in the browser.
# ---------------------------------------------------------------------------

# --- AI content generation --------------------------------------------------
# Mode: "mock" (default, no network, deterministic) or "real" (calls OpenAI).
# Demo/local development and CI tests always use "mock".
CONTENT_AI_MODE=mock

# OpenAI credentials — ONLY read by the generation script, never bundled.
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-terra

# Optional shared secret to authorize manual/remote generation triggers.
CONTENT_GENERATION_SECRET=

# How many days ahead each daily run generates (buffer size). Default 14.
CONTENT_LOOKAHEAD_DAYS=14

# IANA timezone used to resolve "today" for the daily buffer. Default below.
CONTENT_TZ=Europe/Bucharest

# Persist raw AI responses to disk for debugging. NEVER enable in production.
CONTENT_SAVE_RAW=false

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://careu.ro

# --- Advertising (all optional; ads are disabled unless explicitly enabled) --
# When false/empty, only sized placeholders render (development behaviour).
NEXT_PUBLIC_ADS_ENABLED=false
# Google AdSense publisher id, e.g. ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_AD_CLIENT=
# Slot ids per placement (optional).
NEXT_PUBLIC_AD_SLOT_LEADERBOARD=
NEXT_PUBLIC_AD_SLOT_RECTANGLE=
NEXT_PUBLIC_AD_SLOT_INCONTENT=
NEXT_PUBLIC_AD_SLOT_MOBILE=
